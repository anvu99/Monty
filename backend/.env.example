# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it contains secrets.

# PostgreSQL connection string from Neon (https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname

# Random 64-character string for signing JWT tokens
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-string

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Gemini AI API key (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview
AI_TIMEOUT_SECONDS=15
AI_MAX_INPUT_TOKENS=10000
AI_MAX_OUTPUT_TOKENS=1200
AI_MEMORY_EXTRACTION_MAX_OUTPUT_TOKENS=2400
# Database-backed extraction queue; requires the latest Alembic migration.
AI_EXTRACTION_WORKER_ENABLED=true

# Environment: development | production
ENVIRONMENT=development
